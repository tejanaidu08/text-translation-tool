# ── Database ──────────────────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/translation_db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
MAX_INPUT_LENGTH=5000

# Frontend origin (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# ── Translation provider ──────────────────────────────────────────────────────
# "mymemory" = free, no key needed
# "google"   = uses deep-translator GoogleTranslator (also free, no key needed)
TRANSLATION_PROVIDER=mymemory
